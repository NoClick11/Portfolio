    if (p.bx < 0){ p.bx = 0; p.vx = -p.vx; p.ix = -p.ix; }
    else if (p.bx > window.innerWidth){ p.bx = window.innerWidth; p.vx = -p.vx; p.ix = -p.ix; }
    if (p.by < 0){ p.by = 0; p.vy = -p.vy; p.iy = -p.iy; }
    else if (p.by > window.innerHeight){ p.by = window.innerHeight; p.vy = -p.vy; p.iy = -p.iy; }

    var speed = Math.sqrt(p.vx * p.vx + p.vy * p.vy);
    var maxAmbient = 0.35;
    if (speed > maxAmbient){ p.vx = (p.vx / speed) * maxAmbient; p.vy = (p.vy / speed) * maxAmbient; }
