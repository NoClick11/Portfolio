  const dust = Array.from({ length: 46 }, () => ({ x: Math.random(), y: Math.random(), vx: (Math.random() - 0.5) * 0.00015, vy: (Math.random() - 0.5) * 0.00015 }));

  function fit() { const r = cv.getBoundingClientRect(), k = Math.min(devicePixelRatio || 1, 2); W = r.width; S = Math.min(r.width, r.height); cv.width = r.width * k; cv.height = r.height * k; ctx.setTransform(k, 0, 0, k, 0, 0); }
