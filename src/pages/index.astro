<script>
(() => {
  const box = document.getElementById('exp-path'), svg = document.getElementById('exp-svg');
  const title = document.querySelector('#experience .section-title');
  const items = [...box.querySelectorAll('.exp-item')], cardEls = items.map(it => it.querySelector('.exp-card'));
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // rounded-corner polyline, like a PCB trace
  function trace(pts, rad) {
    let d = `M ${pts[0][0]} ${pts[0][1]}`;
    for (let i = 1; i < pts.length - 1; i++) {
      const [px, py] = pts[i - 1], [x, y] = pts[i], [nx, ny] = pts[i + 1];
      const l1 = Math.hypot(x - px, y - py), l2 = Math.hypot(nx - x, ny - y), r = Math.min(rad, l1 / 2, l2 / 2);
      if (r < 1) { d += ` L ${x} ${y}`; continue; }
      d += ` L ${x + (px - x) / l1 * r} ${y + (py - y) / l1 * r} Q ${x} ${y} ${x + (nx - x) / l2 * r} ${y + (ny - y) / l2 * r}`;
    }
    const [lx, ly] = pts[pts.length - 1];
    return d + ` L ${lx} ${ly}`;
  }
  const dot = (n, i) => `<g class="exp-node${n.now ? ' now' : ''}" data-i="${i}">
      ${n.now ? `<circle cx="${n.x}" cy="${n.y}" r="12" fill="rgba(34,255,110,0.12)"/>` : ''}
      <circle class="ring" cx="${n.x}" cy="${n.y}" r="${n.now ? 6.5 : 6}" fill="#040806" stroke-width="2"/>
      ${n.now ? `<circle cx="${n.x}" cy="${n.y}" r="2.5" fill="#22ff6e"/>` : ''}</g>`;

  let len = 0, nodeLen = [], travel, progress, nodeEls = [];
  function draw() {
    const r = box.getBoundingClientRect(), W = r.width, H = r.height, narrow = W < 760;
    const cards = cardEls.map((el, i) => {
      const b = el.getBoundingClientRect();
      const c = { l: b.left - r.left, rt: b.right - r.left, t: b.top - r.top, b: b.bottom - r.top, now: items[i].classList.contains('now') };
      c.cx = (c.l + c.rt) / 2; c.cy = (c.t + c.b) / 2; return c;
    });
    // the line wraps top, one side and bottom of each card, alternating sides, and drops where the next card overlaps
    const pad = narrow ? 10 : 18;
    const drop = i => (Math.max(cards[i].l, cards[i + 1].l) + Math.min(cards[i].rt, cards[i + 1].rt)) / 2;
    // the line starts at the end of the section title, so the heading plugs into the trace
    const range = document.createRange(); range.selectNodeContents(title);
    const lines = range.getClientRects(), tr = lines[lines.length - 1];
    const tEnd = tr.right - r.left, ty = tr.top - r.top + tr.height / 2;
    const side0 = cards[0].rt + pad, in0 = Math.min(Math.max(cards[0].cx, tEnd + 48), side0);
    const start = tEnd + 14 < in0 - 12 ? [tEnd + 14, ty] : [in0, tr.bottom - r.top + 10];
    const pts = [start, [in0, start[1]]], nodes = [];
    cards.forEach((c, i) => {
      const t = c.t - pad, b = c.b + pad, side = i % 2 === 0 ? c.rt + pad : c.l - pad;
      const inX = i === 0 ? in0 : drop(i - 1), outX = i === cards.length - 1 ? c.cx : drop(i);
      pts.push([inX, t], [side, t], [side, b], [outX, b]);
      nodes.push({ x: side, y: c.cy, now: c.now });
    });
    pts.push([cards[cards.length - 1].cx, H]);
    const d = trace(pts, narrow ? 14 : 26);

    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
    svg.innerHTML = `<defs>
        <linearGradient id="exp-g" gradientUnits="userSpaceOnUse" x1="0" y1="${start[1]}" x2="0" y2="${H}">
          <stop offset="0" stop-color="#22ff6e"/>
          <stop offset="0.45" stop-color="#00e5ff" stop-opacity="0.8"/><stop offset="1" stop-color="#00e5ff" stop-opacity="0"/>
        </linearGradient>
        <filter id="exp-blur" x="-10%" y="-10%" width="120%" height="120%"><feGaussianBlur stdDeviation="4"/></filter>
      </defs>
      <path d="${d}" fill="none" stroke="url(#exp-g)" stroke-width="6" opacity="0.18" filter="url(#exp-blur)"/>
      <path id="exp-line" d="${d}" fill="none" stroke="url(#exp-g)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path class="exp-progress" d="${d}" fill="none" stroke="#22ff6e" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0"/>
      <path class="exp-travel" d="${d}" fill="none" stroke="#22ff6e" stroke-width="2.2" stroke-linecap="round" opacity="0.95"/>
      ${nodes.map(dot).join('')}
      <circle cx="${start[0]}" cy="${start[1]}" r="9" fill="rgba(34,255,110,0.12)"/>
      <circle cx="${start[0]}" cy="${start[1]}" r="3.5" fill="#22ff6e"/>`;
    const line = svg.querySelector('#exp-line');
    len = line.getTotalLength();
    travel = svg.querySelector('.exp-travel'); progress = svg.querySelector('.exp-progress');
    nodeEls = [...svg.querySelectorAll('.exp-node')];
    travel.style.strokeDasharray = `70 ${len + 70}`;
    progress.style.strokeDasharray = `${len} ${len}`;
    // where along the line each card's node sits
    nodeLen = nodes.map(n => {
      let best = 0, bd = Infinity;
      for (let s = 0; s <= len; s += 4) { const q = line.getPointAtLength(s), dd = Math.hypot(q.x - n.x, q.y - n.y); if (dd < bd) { bd = dd; best = s; } }
      return best;
    });
    place(len + 40);
  }
  function place(s) {
    if (!travel) return;
    travel.style.strokeDashoffset = 35 - s;
    progress.style.strokeDashoffset = -s;
  }
  function hit(i) {
    const el = cardEls[i];
    el.classList.remove('hit'); void el.offsetWidth; el.classList.add('hit');
    nodeEls[i]?.classList.add('lit');
  }

  // one climb: bottom (first job) -> top (current job), then a short rest
  const CLIMB = 6500, REST = 2200, ease = t => t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2;
  let start = 0, passed = new Set(), running = false;
  function loop(now) {
    if (!start) start = now;
    const t = now - start;
    if (t < CLIMB) {
      if (progress.style.opacity !== '0.55') progress.style.opacity = '0.55';
      const s = (len + 40) - ease(t / CLIMB) * (len + 80);
      place(s);
      nodeLen.forEach((nl, i) => { if (s <= nl && !passed.has(i)) { passed.add(i); hit(i); } });
    } else if (t < CLIMB + REST) {
      progress.style.opacity = '0';
    } else {
      start = now; passed.clear();
      nodeEls.forEach(n => n.classList.remove('lit'));
      place(len + 40);
    }
    requestAnimationFrame(loop);
  }
  function run() { if (running || reduced) return; running = true; requestAnimationFrame(loop); }

  draw();
  new ResizeObserver(() => { draw(); }).observe(box);
  if (document.fonts) document.fonts.ready.then(draw);

  // entrance: cards rise in from the bottom job up to the current one, then the signal starts climbing
  if (!reduced && box.getBoundingClientRect().top > innerHeight) {
    box.classList.add('exp-pending');
    items.forEach((it, i) => it.style.transitionDelay = `${(items.length - 1 - i) * 220}ms`);
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      box.classList.remove('exp-pending');
      setTimeout(() => { items.forEach(it => it.style.transitionDelay = ''); run(); }, items.length * 220 + 300);
    }, { threshold: 0.2 });
    io.observe(box);
  } else run();
})();
</script>
<script>
(() => {
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const onVisible = (el, fn) => {
    const io = new IntersectionObserver(([e]) => fn(e.isIntersecting), { threshold: 0.2 });
    io.observe(el);
  };

  // --- Cartomancer: dungeon map emerging from noise, like a diffusion run ---
  const cv = document.getElementById('proj-map'), ctx = cv.getContext('2d'), cap = document.getElementById('proj-map-cap');
  const GW = 48, GH = 36;
  let grid, noise, cw, ch, mapStart = 0, mapOn = false;
  function makeMap() {
    grid = Array.from({ length: GH }, () => Array(GW).fill(0));
    const rooms = [];
    for (let k = 0; k < 40 && rooms.length < 8; k++) {
      const w = 5 + (Math.random() * 7 | 0), h = 4 + (Math.random() * 5 | 0);
      const x = 2 + (Math.random() * (GW - w - 4) | 0), y = 2 + (Math.random() * (GH - h - 4) | 0);
      if (rooms.some(r => x < r.x + r.w + 2 && x + w + 2 > r.x && y < r.y + r.h + 2 && y + h + 2 > r.y)) continue;
      rooms.push({ x, y, w, h });
    }
    rooms.forEach(r => { for (let j = r.y; j < r.y + r.h; j++) for (let i = r.x; i < r.x + r.w; i++) grid[j][i] = 1; });
    for (let k = 1; k < rooms.length; k++) {
      const a = rooms[k - 1], b = rooms[k];
      const ax = a.x + (a.w / 2 | 0), ay = a.y + (a.h / 2 | 0), bx = b.x + (b.w / 2 | 0), by = b.y + (b.h / 2 | 0);
      for (let i = Math.min(ax, bx); i <= Math.max(ax, bx); i++) if (!grid[ay][i]) grid[ay][i] = 2;
      for (let j = Math.min(ay, by); j <= Math.max(ay, by); j++) if (!grid[j][bx]) grid[j][bx] = 2;
    }
    rooms.forEach((r, k) => { if (k % 3 === 0) grid[r.y + 1][r.x + 1] = 3; });
    noise = Array.from({ length: GH }, () => Array.from({ length: GW }, () => Math.random()));
  }
  function fitMap() {
    const r = cv.getBoundingClientRect(), k = Math.min(devicePixelRatio || 1, 2);
    cv.width = r.width * k; cv.height = r.height * k; ctx.setTransform(k, 0, 0, k, 0, 0);
    cw = r.width / GW; ch = r.height / GH;
  }
  const tone = v => v === 1 ? [22, 52, 44] : v === 2 ? [14, 38, 34] : v === 3 ? [34, 255, 110] : [6, 12, 10];
  function drawMap(now) {
    const p = reduced ? 1 : Math.min(1, (now - mapStart) / 7000), ease = 1 - (1 - p) ** 3;
    for (let j = 0; j < GH; j++) for (let i = 0; i < GW; i++) {
      const n = noise[j][i], done = ease > n * 0.85, mix = Math.min(1, ease * 1.15);
      const f = reduced ? n : n + Math.sin(now / 90 + i * 7 + j * 13) * 0.15;
      const nz = [10 + f * 40, 40 + f * 90, 36 + f * 70], tg = tone(grid[j][i]);
      const c = done ? tg : nz.map((v, q) => v * (1 - mix) + tg[q] * mix);
      ctx.fillStyle = `rgb(${c[0] | 0},${c[1] | 0},${c[2] | 0})`;
      ctx.fillRect(i * cw, j * ch, cw + 0.5, ch + 0.5);
