    ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
    ctx.textBaseline = 'middle';
    var lastSizeIdx = -1;
    var lastStyleIdx = -1;
    for (var i = 0; i < particles.length; i++){
      var p = particles[i];
      if (animated) stepParticle(p);
      if (p.sizeIdx !== lastSizeIdx){
        ctx.font = FONT_CACHE[p.sizeIdx];
        lastSizeIdx = p.sizeIdx;
      }
      if (p.styleIdx !== lastStyleIdx){
        ctx.fillStyle = STYLE_CACHE[p.styleIdx].css;
        lastStyleIdx = p.styleIdx;
      }
      ctx.fillText(p.ch, p.bx, p.by);
    }

    /* a handful of real stack logos (Laravel, Vue, TypeScript, Python)
       drifting in the same field as the characters */
    for (var j = 0; j < iconParticles.length; j++){
      var ip = iconParticles[j];
      if (animated) stepParticle(ip);
      ctx.save();
      ctx.translate(ip.bx, ip.by);
      ctx.scale(ip.scale, ip.scale);
      ctx.translate(-12, -12);
      ctx.fillStyle = STYLE_CACHE[ip.styleIdx].css;
      ctx.fill(ICON_SHAPES[ip.iconIdx]);
      ctx.restore();
    }
  }

  if (reduceMotion){
    if (glow) glow.style.display = 'none';
    drawFrame(false);
  } else {
    (function loop(){ drawFrame(true); requestAnimationFrame(loop); })();
  }
})();
</script>
<script>
(() => {
  const css = getComputedStyle(document.documentElement);
  const FONT = css.getPropertyValue('--font');
  const A = css.getPropertyValue('--accent').trim(), B = css.getPropertyValue('--accent-2').trim(), INK = css.getPropertyValue('--ink').trim(), DIM = css.getPropertyValue('--ink-dim').trim();
