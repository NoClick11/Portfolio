  new ResizeObserver(() => { fitMap(); if (reduced || !mapOn) drawMap(performance.now()); }).observe(cv);
  onVisible(cv, vis => {
    if (vis && !mapOn) { mapOn = true; if (!mapStart) mapStart = performance.now(); requestAnimationFrame(drawMap); }
    else if (!vis) mapOn = false;
  });

  // --- Click NFS-e: example artisan session typed out ---
  const term = document.getElementById('proj-term');
  const LINES = [
    ['$', 'composer require noclick11/click-nfse'],
    ['o', '<span class="ok">✓</span> noclick11/click-nfse instalado'],
    ['$', 'php artisan nfse:verificar-certificado'],
    ['o', '<span class="ok">✓</span> certificado A1 válido · EKU cliente ok'],
    ['o', '<span class="c">→ EmitirNfseJob</span>'],
    ['step', '01 elegibilidade', 'ok'],
    ['step', '02 reserva do nDPS', '000124'],
    ['step', '03 DPS assinada (XMLDSIG)', 'ok'],
    ['step', '04 envio à Sefin (mTLS)', '200'],
    ['step', '05 desfecho', 'AUTORIZADA']
  ];
  const wait = ms => new Promise(r => setTimeout(r, reduced ? 0 : ms));
  async function play() {
    while (true) {
      term.innerHTML = '';
      for (const l of LINES) {
        const row = document.createElement('div'); term.appendChild(row);
        if (l[0] === '$') {
          row.innerHTML = '<span class="p">❯</span> <span class="t"></span><span class="cur"></span>';
          const t = row.querySelector('.t');
          for (const chr of l[1]) { t.textContent += chr; await wait(38 + Math.random() * 40); }
          await wait(350); row.querySelector('.cur').remove();
        } else if (l[0] === 'step') {
          const dots = '.'.repeat(Math.max(2, 28 - l[1].length));
          row.innerHTML = `  <span class="o">${l[1]} ${dots}</span> <span class="w">…</span>`;
          await wait(520);
          row.innerHTML = `  <span class="o">${l[1]} ${dots}</span> <span class="ok">${l[2]}</span>`;
        } else { row.innerHTML = l[1]; await wait(260); }
      }
      const end = document.createElement('div'); end.innerHTML = '<span class="p">❯</span> <span class="cur"></span>'; term.appendChild(end);
      if (reduced) return;
      await wait(4200);
    }
  }
  let started = false;
  onVisible(term, vis => { if (vis && !started) { started = true; play(); } });
})();
</script>
</body>
</html>
