      for (let j = 0; j <= GH; j += 4) { ctx.beginPath(); ctx.moveTo(0, j * ch); ctx.lineTo(GW * cw, j * ch); ctx.stroke(); }
    }
    cap.textContent = p < 1 ? `passo ${Math.round(p * 28)}/28` : '✓ masmorra.png';
    if (reduced) return;
    if (now - mapStart > 10500) { makeMap(); mapStart = now; }
    if (mapOn) requestAnimationFrame(drawMap);
