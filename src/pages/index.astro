  });
  const mix = k => `${Math.round(34 * k)},${Math.round(229 + 26 * k)},${Math.round(255 - 145 * k)}`;
  const curve = (a, b, t, seed) => {
    const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2, dx = b.y - a.y, dy = a.x - b.x, w = Math.sin(t / 4200 + seed) * 0.035;
    return { cx: mx + dx * w, cy: my + dy * w };
