      ctx.globalAlpha = Math.sin(k * Math.PI) * (p.seg < 0 ? 0.5 : 1) + (p.seg < 0 ? 0.5 : 0);
      ctx.fillStyle = A; ctx.shadowColor = A; ctx.shadowBlur = 6; ctx.beginPath(); ctx.arc(pt.x, pt.y, 2, 0, 7); ctx.fill();
      ctx.globalAlpha = 1;
      if (p.k >= 1 && p.seg < 0) { p.seg = 0; p.k = 0; }
    }
    ctx.shadowBlur = 0; pulses = pulses.filter(p => !(p.seg === 0 && p.k >= 1));

    const fs = S < 380 ? 9.5 : 11.5;
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    G.forEach((g, i) => {
      const on = open[i];
      g.sats.forEach(s => {
        ctx.fillStyle = '#040806'; ctx.strokeStyle = `rgba(${mix(on)},${0.4 + on * 0.5})`; ctx.lineWidth = 1.2;
        ctx.beginPath(); ctx.arc(s.x, s.y, 3 + on * 1.5, 0, 7); ctx.fill(); ctx.stroke();
        if (on > 0.15) {
