    return { cx: mx + dx * w, cy: my + dy * w };
  };
  const qpt = (a, c, b, k) => ({ x: (1 - k) ** 2 * a.x + 2 * (1 - k) * k * c.cx + k * k * b.x, y: (1 - k) ** 2 * a.y + 2 * (1 - k) * k * c.cy + k * k * b.y });

  function frame(t) {
    open = open.map((v, i) => v + ((i === active ? 1 : 0) - v) * (reduced ? 1 : 0.025));
    const H = cv.getBoundingClientRect().height;
    ctx.clearRect(0, 0, W, H);
    for (const d of dust) { if (!reduced) { d.x = (d.x + d.vx + 1) % 1; d.y = (d.y + d.vy + 1) % 1; } }
    for (let i = 0; i < dust.length; i++) for (let j = i + 1; j < dust.length; j++) {
      const a = dust[i], b = dust[j], dd = Math.hypot((a.x - b.x) * S, (a.y - b.y) * S);
      if (dd < S * 0.14) { ctx.strokeStyle = `rgba(0,229,255,${0.09 * (1 - dd / (S * 0.14))})`; ctx.beginPath(); ctx.moveTo(a.x * S, a.y * S); ctx.lineTo(b.x * S, b.y * S); ctx.stroke(); }
    }
    dust.forEach(d => { ctx.fillStyle = 'rgba(0,229,255,0.25)'; ctx.fillRect(d.x * S - 1, d.y * S - 1, 2, 2); });

    const G = geo(t);
    G.forEach((g, i) => {
      const on = open[i], cc = curve(g.c, g.p, t, i);
      ctx.strokeStyle = `rgba(${mix(on)},${0.2 + on * 0.4})`; ctx.lineWidth = 1 + on;
      ctx.beginPath(); ctx.moveTo(g.c.x, g.c.y); ctx.quadraticCurveTo(cc.cx, cc.cy, g.p.x, g.p.y); ctx.stroke();
      g.sats.forEach((s, j) => {
        const sc = curve(g.p, s, t, i * 7 + j);
        ctx.strokeStyle = `rgba(${mix(on)},${0.1 + on * 0.35})`; ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(g.p.x, g.p.y); ctx.quadraticCurveTo(sc.cx, sc.cy, s.x, s.y); ctx.stroke();
      });
    });
    if (!reduced && Math.random() < 0.05) {
      const g = G[active]; pulses.push({ seg: -1, k: 0, sat: Math.random() * g.sats.length | 0 });
    }
    for (const p of pulses) {
      const g = G[active]; p.k += 0.006;
      const s = g.sats[p.sat] || g.sats[0];
      // eased along each segment so the pulse glides instead of moving at constant speed
      const k = Math.min(p.k, 1), e = k * k * (3 - 2 * k);
      const pt = p.seg < 0 ? qpt(g.c, curve(g.c, g.p, t, active), g.p, e) : qpt(g.p, curve(g.p, s, t, active * 7 + p.sat), s, e);
      ctx.globalAlpha = Math.sin(k * Math.PI) * (p.seg < 0 ? 0.5 : 1) + (p.seg < 0 ? 0.5 : 0);
      ctx.fillStyle = A; ctx.shadowColor = A; ctx.shadowBlur = 6; ctx.beginPath(); ctx.arc(pt.x, pt.y, 2, 0, 7); ctx.fill();
      ctx.globalAlpha = 1;
      if (p.k >= 1 && p.seg < 0) { p.seg = 0; p.k = 0; }
    }
    ctx.shadowBlur = 0; pulses = pulses.filter(p => !(p.seg === 0 && p.k >= 1));

    const fs = S < 380 ? 9.5 : 11.5;
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    G.forEach((g, i) => {
      const on = open[i];
      g.sats.forEach(s => {
        ctx.fillStyle = '#040806'; ctx.strokeStyle = `rgba(${mix(on)},${0.4 + on * 0.5})`; ctx.lineWidth = 1.2;
        ctx.beginPath(); ctx.arc(s.x, s.y, 3 + on * 1.5, 0, 7); ctx.fill(); ctx.stroke();
        if (on > 0.15) {
          ctx.globalAlpha = on; ctx.font = `600 ${fs - 1}px ${FONT}`; ctx.fillStyle = INK;
          const dx = s.x - g.p.x, dy = s.y - g.p.y, L = Math.hypot(dx, dy) || 1;
          ctx.fillText(s.label, s.x + dx / L * (fs * 2.6), s.y + dy / L * (fs * 1.3)); ctx.globalAlpha = 1;
        }
      });
      const r = S * (0.03 + on * 0.012);
      ctx.fillStyle = `rgba(34,255,110,${on * 0.15})`; ctx.beginPath(); ctx.arc(g.p.x, g.p.y, r + 10, 0, 7); ctx.fill();
      ctx.fillStyle = '#040806'; ctx.strokeStyle = on > 0.5 ? A : B; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.arc(g.p.x, g.p.y, r, 0, 7); ctx.fill(); ctx.stroke();
      ctx.font = `800 ${fs}px ${FONT}`; ctx.fillStyle = on > 0.5 ? A : DIM;
      const ly = g.p.y + (g.p.y < S / 2 ? -1 : 1) * (r + fs + 2);
      ctx.fillText(CAPS[i].name, g.p.x, ly);
    });
    const pr = S * 0.065, pulse = 0.5 + 0.5 * Math.sin(t / 1600);
    ctx.fillStyle = `rgba(34,255,110,${0.08 + pulse * 0.08})`; ctx.beginPath(); ctx.arc(S / 2, S / 2, pr + 12 + pulse * 3, 0, 7); ctx.fill();
    ctx.fillStyle = '#040806'; ctx.strokeStyle = A; ctx.lineWidth = 2; ctx.beginPath(); ctx.arc(S / 2, S / 2, pr, 0, 7); ctx.fill(); ctx.stroke();
    ctx.fillStyle = A; ctx.font = `800 ${fs + 3}px ${FONT}`; ctx.fillText('IA', S / 2, S / 2 + 1);
    if (!reduced && visible) requestAnimationFrame(frame);
  }
  let visible = true;
  new IntersectionObserver(([e]) => { const was = visible; visible = e.isIntersecting; if (visible && !was && !reduced) requestAnimationFrame(frame); }).observe(cv);
  fit(); addEventListener('resize', () => { fit(); if (reduced) frame(performance.now()); });
  if (reduced) btns.forEach(b => b.addEventListener('click', () => frame(performance.now())));
  requestAnimationFrame(frame);
})();
</script>
</body>
</html>
