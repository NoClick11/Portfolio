---
---
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate icon" href="/favicon.ico" />
<title>Manuel Bahamonde — AI-Driven Software Engineer</title>
<meta name="description" content="Portfólio de Manuel Bahamonde, AI-Driven Software Engineer especialista em soluções com inteligência artificial e desenvolvimento full stack." />
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.001ms !important;animation-iteration-count:1 !important;transition-duration:0.001ms !important;}
  }

  :root{
    --bg:#040806; --bg-alt:#081210; --ink:#dffef0; --ink-dim:#5f9a8f;
    --accent:#22ff6e; --accent-2:#00e5ff; --on-accent:#04140a;
    --border:rgba(0,229,255,0.16); --border-strong:rgba(34,255,110,0.45);
    --track-bg:rgba(0,229,255,0.08);
    --radius-sm:2px; --radius-xs:1px; --radius-md:2px;
    --font:ui-monospace,"SF Mono","JetBrains Mono",Menlo,Consolas,monospace;
  }

  body{
    background:var(--bg);color:var(--ink);font-family:var(--font);
    min-height:100vh;position:relative;
  }
  body::before{
    content:"";position:fixed;inset:0;z-index:0;pointer-events:none;
    background:repeating-linear-gradient(0deg,rgba(34,255,110,0.02) 0px,rgba(34,255,110,0.02) 1px,transparent 1px,transparent 3px);
  }
  body::after{
    content:"";position:fixed;inset:16px;z-index:0;pointer-events:none;
    border:1px solid rgba(0,229,255,0.15);
  }
  a{color:inherit;}
  :focus-visible{outline:2px solid var(--accent-2);outline-offset:2px;}

  #bgfx{position:fixed;inset:0;z-index:0;pointer-events:none;}
  #cursor-glow{
    position:fixed;top:0;left:0;width:600px;height:600px;z-index:0;
    border-radius:50%;pointer-events:none;mix-blend-mode:screen;
    background:radial-gradient(circle,rgba(34,255,110,0.10) 0%,rgba(0,229,255,0.05) 35%,transparent 70%);
    transform:translate3d(-9999px,-9999px,0);
    transition:transform 150ms linear;
  }
  @media (prefers-reduced-motion: reduce){ #cursor-glow{display:none;} }

  .page{position:relative;z-index:1;}

  /* alternating section fill: faint circuit/grid */
  .pattern-bg{
    background-image:
      radial-gradient(rgba(0,229,255,0.14) 1px,transparent 1.5px),
      linear-gradient(rgba(0,229,255,0.045) 1px,transparent 1px),
      linear-gradient(90deg,rgba(0,229,255,0.045) 1px,transparent 1px);
    background-size:44px 44px,44px 44px,44px 44px;
    background-position:-1px -1px;
  }

  /* ---- Nav ---- */
  nav.site{
    display:flex;align-items:center;justify-content:space-between;
    padding:22px clamp(20px,5vw,64px);
  }
  .brand{font-weight:800;font-size:16px;letter-spacing:0.02em;}
  .brand::before{content:"~/";color:var(--ink-dim);}
  .nav-links{display:flex;gap:28px;list-style:none;}
  .nav-links a{color:var(--ink-dim);text-decoration:none;font-size:13px;letter-spacing:0.03em;}
  .nav-links a:hover{color:var(--ink);}
  .nav-cta{
    border:1px solid var(--accent-2);color:var(--accent-2);
    padding:9px 16px;border-radius:var(--radius-sm);
    font-size:12.5px;font-weight:700;letter-spacing:0.04em;text-decoration:none;
  }
  .nav-cta:hover{background:rgba(0,229,255,0.08);}

  /* ---- Hero ---- */
  .hero{padding:min(9vw,72px) clamp(20px,5vw,64px) 56px;}
  .hero-eyebrow{display:inline-block;font-size:12px;letter-spacing:0.14em;color:var(--ink-dim);margin-bottom:18px;}
  .hero h1{
    font-weight:800;font-size:clamp(38px,7vw,76px);line-height:0.98;letter-spacing:0.005em;
    text-wrap:balance;max-width:16ch;
  }
  .hero h1::after{content:"_";animation:blink 1s steps(1) infinite;color:var(--accent);}
  @keyframes blink{50%{opacity:0;}}
  .hero .role{margin-top:14px;font-size:15px;letter-spacing:0.05em;color:var(--ink-dim);text-transform:uppercase;}
  .hero p.bio{margin-top:20px;max-width:60ch;color:var(--ink-dim);font-size:14.5px;line-height:1.75;}
  .hero-ctas{display:flex;gap:14px;margin-top:32px;flex-wrap:wrap;}
  .btn{
    font-weight:700;font-size:13.5px;letter-spacing:0.02em;
    padding:13px 22px;border-radius:var(--radius-sm);text-decoration:none;cursor:pointer;
    display:inline-flex;align-items:center;gap:8px;
  }
  .btn-primary{background:var(--accent);color:var(--on-accent);border:1px solid var(--accent);}
  .btn-primary:hover{filter:brightness(1.1);}
  .btn-ghost{background:transparent;color:var(--accent-2);border:1px solid var(--accent-2);}
  .btn-ghost:hover{background:rgba(0,229,255,0.08);}

  .lvl-badge{
    margin-top:36px;display:inline-flex;align-items:center;gap:14px;
    padding:12px 18px;border-radius:var(--radius-sm);border:1px solid var(--accent-2);
    background:var(--bg-alt);
  }
  .lvl-num{font-weight:800;font-size:22px;color:var(--accent);}
  .lvl-meta{font-size:10.5px;letter-spacing:0.08em;color:var(--ink-dim);text-transform:uppercase;}
  .xp-track{width:150px;height:8px;border-radius:3px;background:var(--track-bg);overflow:hidden;margin-top:6px;}
  .xp-fill{height:100%;width:64%;background:var(--accent);}

  /* ---- Sections ---- */
  section{padding:clamp(72px,11vw,112px) clamp(20px,5vw,64px);}
  .section-title{
    font-weight:800;font-size:clamp(22px,3vw,30px);letter-spacing:0.01em;
    text-transform:uppercase;margin-bottom:34px;display:flex;align-items:baseline;gap:12px;
  }
  .section-title .num{font-size:13px;color:var(--accent);font-weight:600;}

  /* ---- AI solutions (orbital LLM core) ---- */
  #ai{padding-top:clamp(56px,7vw,80px);padding-bottom:clamp(56px,7vw,80px);}
  .ai-lead{margin-top:-18px;color:var(--ink-dim);font-size:14px;line-height:1.7;max-width:62ch;}
  .ai-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:40px;margin-top:12px;align-items:center;}
  @media (max-width:860px){.ai-grid{grid-template-columns:1fr;gap:24px;}}
  .ai-orb{aspect-ratio:1/1;max-width:min(100%,500px);width:100%;margin-inline:auto;}
  .ai-orb canvas{display:block;width:100%;height:100%;cursor:pointer;}
  .ai-list{display:flex;flex-direction:column;border-top:1px solid var(--border);}
  .ai-list button{
    font:inherit;background:none;border:0;border-bottom:1px solid var(--border);color:var(--ink-dim);
    text-align:left;padding:14px 4px;cursor:pointer;display:grid;grid-template-columns:22px 1fr;gap:10px;align-items:baseline;
    transition:color 150ms;
  }
  .ai-list .dot{width:9px;height:9px;border:1.5px solid currentColor;border-radius:50%;display:inline-block;}
  .ai-list .n{font-size:14px;font-weight:800;}
  .ai-list button[aria-pressed="true"]{color:var(--accent);}
  .ai-list button[aria-pressed="true"] .dot{background:var(--accent);}
  .ai-list button:hover{color:var(--ink);}
  .ai-details{display:grid;padding-top:22px;}
  .ai-detail{grid-area:1/1;opacity:0;visibility:hidden;transition:opacity 500ms ease,visibility 0s linear 500ms;}
  .ai-detail.on{opacity:1;visibility:visible;transition:opacity 600ms ease 200ms,visibility 0s;}
  .ai-sig{font-size:10.5px;letter-spacing:0.1em;text-transform:uppercase;color:var(--accent-2);}
  .ai-detail p{margin-top:10px;color:var(--ink-dim);font-size:13.5px;line-height:1.8;}
  .ai-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:14px;}
  .ai-tags span{font-size:11px;color:var(--ink-dim);border:1px solid var(--border);padding:4px 9px;border-radius:var(--radius-xs);}

  /* ---- Card window (shared by project + contact cards) ---- */
  .card-window{
    border:1px solid var(--border);border-radius:var(--radius-md);
    background:var(--bg-alt);overflow:hidden;display:flex;flex-direction:column;
  }
  .card-window-bar{
    display:flex;align-items:center;gap:9px;padding:10px 16px;
    border-bottom:1px solid var(--border);background:rgba(255,255,255,0.025);
  }
  .card-window-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}
  .card-window-title{
    font-size:11px;color:var(--ink-dim);letter-spacing:0.02em;
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
  }
  .card-window-body{padding:22px;display:flex;flex-direction:column;gap:14px;flex:1;}

  /* ---- Projects (wide showcases: text + live visual) ---- */
  .proj-shows{display:flex;flex-direction:column;gap:clamp(56px,8vw,96px);}
  .proj-divider{position:relative;height:1px;background:linear-gradient(90deg,transparent,var(--border) 18%,rgba(34,255,110,0.35) 50%,var(--border) 82%,transparent);}
  .proj-divider span{
    position:absolute;left:50%;top:50%;width:9px;height:9px;transform:translate(-50%,-50%) rotate(45deg);
    background:var(--bg);border:1.5px solid var(--accent);box-shadow:0 0 0 5px var(--bg),0 0 12px rgba(34,255,110,0.35);
  }
  .proj-show{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:clamp(28px,4vw,56px);align-items:center;}
  .proj-show.flip .proj-info{order:2;}
  @media (max-width:860px){.proj-show{grid-template-columns:1fr;}.proj-show.flip .proj-info{order:0;}}
  .proj-info{display:flex;flex-direction:column;gap:16px;}
  .proj-kind{font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--accent-2);}
  .proj-name{font-size:clamp(30px,4.4vw,46px);font-weight:800;line-height:1.02;text-wrap:balance;}
  .proj-desc{color:var(--ink-dim);font-size:14px;line-height:1.75;max-width:52ch;}
  .proj-facts{display:flex;flex-wrap:wrap;gap:22px;padding:14px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border);}
  .proj-facts div{display:flex;flex-direction:column;gap:2px;}
  .proj-facts b{font-size:18px;font-weight:800;color:var(--accent);font-variant-numeric:tabular-nums;}
  .proj-facts span{font-size:10.5px;letter-spacing:0.08em;text-transform:uppercase;color:var(--ink-dim);}
  .proj-stack{display:flex;flex-wrap:wrap;gap:6px;}
  .proj-stack span{font-size:11px;color:var(--ink-dim);border:1px solid var(--border);padding:4px 9px;border-radius:var(--radius-xs);}
  .proj-actions{display:flex;flex-wrap:wrap;gap:10px;}
  .proj-visual{
    min-width:0;border-color:rgba(34,255,110,0.25);background:#030605;
    box-shadow:0 0 0 1px rgba(34,255,110,0.04),0 24px 60px rgba(0,0,0,0.5),0 0 40px rgba(34,255,110,0.06);
  }
  .proj-visual .card-window-title{flex:1;min-width:0;}
  .proj-badge{font-size:10px;color:var(--ink-dim);border:1px solid var(--border);padding:2px 6px;flex-shrink:0;white-space:nowrap;}
  .proj-visual-map{width:100%;max-width:460px;justify-self:center;}
  .proj-map{display:block;width:100%;aspect-ratio:4/3;max-width:100%;}
  .proj-term{
    margin:0;padding:18px 18px 22px;font:inherit;font-size:12.5px;line-height:1.75;
    height:300px;overflow:hidden;white-space:pre-wrap;color:var(--ink);
  }
  @media (max-width:480px){.proj-term{font-size:11px;height:280px;}}
  .proj-term .p,.proj-term .ok{color:var(--accent);}
  .proj-term .o{color:var(--ink-dim);}
  .proj-term .c{color:var(--accent-2);}
  .proj-term .w{color:#ffd166;}
  .proj-term .cur{display:inline-block;width:8px;height:15px;background:var(--accent);vertical-align:-3px;animation:blink 1s steps(1) infinite;}
  .proj-github-btn{
    display:inline-flex;align-items:center;gap:9px;
    padding:10px 16px;border-radius:var(--radius-sm);border:1px solid var(--accent);
    color:var(--accent);text-decoration:none;font-size:12.5px;font-weight:700;letter-spacing:0.02em;
    transition:background 150ms,color 150ms,transform 150ms;
  }
  .proj-github-btn svg{width:15px;height:15px;flex-shrink:0;}
  .proj-github-btn:hover{background:var(--accent);color:var(--on-accent);transform:translateY(-1px);}

  .proj-details-btn{
    display:inline-flex;align-items:center;gap:8px;
    padding:10px 16px;border-radius:var(--radius-sm);border:1px solid var(--border);
    color:var(--ink-dim);text-decoration:none;font-size:12.5px;font-weight:700;letter-spacing:0.02em;
    transition:border-color 150ms,color 150ms,transform 150ms;
  }
  .proj-details-btn svg{width:14px;height:14px;flex-shrink:0;transition:transform 150ms;}
  .proj-details-btn:hover{border-color:var(--accent-2);color:var(--accent-2);transform:translateY(-1px);}
  .proj-details-btn:hover svg{transform:translateX(3px);}

  /* ---- Contact ---- */
  .contact-intro{display:flex;flex-direction:column;align-items:flex-start;gap:18px;max-width:60ch;}
  .status-pill{
    display:inline-flex;align-items:center;gap:9px;
    font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:var(--accent);
    border:1px solid var(--accent);padding:7px 13px;border-radius:999px;
  }
  .status-dot{width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 6px var(--accent);animation:pulse-dot 2.2s ease-in-out infinite;}
  @keyframes pulse-dot{0%,100%{opacity:1;}50%{opacity:0.3;}}
  .contact-lead{color:var(--ink-dim);font-size:14.5px;line-height:1.7;}

  .contact-email{
    display:inline-flex;align-items:center;gap:14px;
    padding:17px 24px;border-radius:var(--radius-md);border:1px solid var(--border-strong);
    background:var(--bg-alt);
    font-weight:800;letter-spacing:0.005em;white-space:nowrap;
    font-size:clamp(17px,3.4vw,30px);line-height:1;color:var(--ink);text-decoration:none;
    transition:color 180ms,border-color 180ms,background 180ms,transform 180ms;
  }
  .contact-email-icon{width:0.82em;height:0.82em;flex-shrink:0;color:var(--accent-2);}
  .contact-email-icon svg{width:100%;height:100%;display:block;}
  .contact-email-arrow{
    color:var(--accent-2);font-weight:700;flex-shrink:0;
    opacity:0;transform:translateX(-6px);transition:opacity 150ms,transform 150ms;
  }
  .contact-email:hover{
    color:var(--accent-2);border-color:var(--accent-2);
    background:rgba(0,229,255,0.07);transform:translateY(-2px);
  }
  .contact-email:hover .contact-email-arrow{opacity:1;transform:translateX(0);}
  @media (max-width:480px){
    .contact-email{font-size:15px;padding:14px 18px;gap:10px;}
  }
  @media (max-width:360px){
    .contact-email{font-size:12.5px;padding:12px 14px;gap:8px;}
  }

  .contact-social{display:flex;gap:26px;margin-top:6px;flex-wrap:wrap;}
  .social-btn{display:flex;flex-direction:column;align-items:center;gap:9px;text-decoration:none;}
  .social-btn-circle{
    width:46px;height:46px;border-radius:50%;border:1px solid var(--border);
    display:flex;align-items:center;justify-content:center;color:var(--ink-dim);
    transition:border-color 150ms,color 150ms,background 150ms,transform 150ms;
  }
  .social-btn-circle svg{width:19px;height:19px;}
  .social-btn-label{
    font-size:10.5px;letter-spacing:0.07em;text-transform:uppercase;color:var(--ink-dim);
    transition:color 150ms;
  }
  .social-btn:hover .social-btn-circle{
    border-color:var(--accent-2);color:var(--accent-2);
    background:rgba(0,229,255,0.08);transform:translateY(-2px);
  }
  .social-btn:hover .social-btn-label{color:var(--accent-2);}

  /* ---- Experience (trace wrapping each card) ---- */
  .exp-path{position:relative;display:flex;flex-direction:column;gap:76px;padding-block:40px;}
  .exp-path svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible;z-index:0;}
  .exp-item{position:relative;z-index:1;width:62%;}
  .exp-item:nth-of-type(odd){margin-left:2%;}
  .exp-item:nth-of-type(even){margin-left:36%;}
  @media (max-width:760px){
    .exp-path{gap:56px;padding-block:28px;}
    .exp-item:nth-of-type(n){width:calc(100% - 32px);margin-left:16px;}
  }
  .exp-card{
    background:var(--bg-alt);border:1px solid var(--border);border-radius:var(--radius-md);
    padding:22px 24px;transition:border-color 150ms;
  }
  .exp-card:hover{border-color:var(--accent-2);}
  .exp-item.now .exp-card{border-color:rgba(34,255,110,0.4);}
  .exp-period{font-size:11px;letter-spacing:0.06em;color:var(--ink-dim);text-transform:uppercase;}
  .exp-item.now .exp-period{color:var(--accent);}
  .exp-role{margin-top:8px;font-weight:800;font-size:17px;text-wrap:balance;}
  .exp-org{font-size:12px;color:var(--accent-2);margin-top:3px;}
  .exp-list{margin-top:12px;padding-left:18px;color:var(--ink-dim);font-size:13px;line-height:1.7;}
  .exp-list li{margin-bottom:2px;}
  .exp-travel{filter:drop-shadow(0 0 4px var(--accent));}
  .exp-progress{transition:opacity 900ms ease;}
  .exp-node .ring{stroke:var(--accent-2);transition:stroke 400ms ease;}
  .exp-node.lit .ring,.exp-node.now .ring{stroke:var(--accent);}
  /* progression: the signal climbs from the first job to the current one, pulsing each card on the way */
  .exp-card.hit{animation:exp-hit 1.1s ease-out;}
  .exp-item.now .exp-card.hit{animation:exp-arrive 1.6s ease-out;}
  @keyframes exp-hit{
    0%{box-shadow:0 0 0 0 rgba(0,229,255,0);}
    25%{border-color:var(--accent-2);box-shadow:0 0 0 1px rgba(0,229,255,0.35),0 0 26px rgba(0,229,255,0.16);}
    100%{box-shadow:0 0 0 0 rgba(0,229,255,0);}
  }
  @keyframes exp-arrive{
    0%{box-shadow:0 0 0 0 rgba(34,255,110,0);}
    25%{border-color:var(--accent);box-shadow:0 0 0 1px rgba(34,255,110,0.5),0 0 38px rgba(34,255,110,0.22);}
    100%{box-shadow:0 0 0 0 rgba(34,255,110,0);}
  }
  .exp-item{transition:opacity 650ms ease,transform 650ms ease;}
  .exp-path.exp-pending .exp-item{opacity:0;transform:translateY(18px);}
  @media (prefers-reduced-motion: reduce){.exp-travel,.exp-progress{display:none;}.exp-card.hit{animation:none;}}

  /* ---- Footer ---- */
  footer.site{
    padding:32px clamp(20px,5vw,64px) 48px;border-top:1px solid var(--border);
    display:flex;justify-content:center;
  }
  .footer-line{font-size:11.5px;color:var(--ink-dim);letter-spacing:0.04em;}
  .footer-links{display:flex;gap:18px;}
  .footer-links a{text-decoration:none;font-size:13px;font-weight:600;}
  .footer-links a:hover{color:var(--accent-2);}
</style>
</head>
<body>

<canvas id="bgfx" aria-hidden="true"></canvas>
<div id="cursor-glow"></div>

<div class="page">

  <nav class="site">
    <div class="brand">Manuel Bahamonde</div>
    <ul class="nav-links">
      <li><a href="#ai">IA</a></li>
      <li><a href="#projects">Projects</a></li>
      <li><a href="#experience">Experience</a></li>
    </ul>
    <a class="nav-cta" href="#contact">Contato</a>
  </nav>

  <header class="hero">
    <span class="hero-eyebrow">Soluções com IA &middot; Full Stack &middot; Salvador, BA</span>
    <h1>Manuel Bahamonde</h1>
    <div class="role">AI&#8209;Driven Software Engineer</div>
    <p class="bio">Engenheiro de software com 3 anos de experiência, especializado em criar soluções com inteligência artificial sobre uma base sólida de backend e desenvolvimento full stack. De pipelines locais de geração de imagens com IA à automação de coleta de dados judiciais, transformo modelos e dados em sistemas confiáveis e escaláveis — hoje como desenvolvedor backend pleno na JusCalculos.</p>
    <div class="hero-ctas">
      <a class="btn btn-primary" href="#projects">Ver Projetos</a>
      <a class="btn btn-ghost" href="#contact">Contato</a>
    </div>
    <div class="lvl-badge">
      <div class="lvl-num">3</div>
      <div>
        <div class="lvl-meta">Anos de experiência</div>
        <div class="xp-track"><div class="xp-fill"></div></div>
      </div>
    </div>
  </header>

  <section id="ai" class="pattern-bg">
    <div class="section-title"><span class="num">02</span>Soluções com IA</div>
    <p class="ai-lead">Soluções com inteligência artificial que já desenvolvi: atendimento automatizado, cálculos jurídicos e agentes trabalhando em conjunto.</p>
    <div class="ai-grid">
      <div class="ai-orb"><canvas id="ai-orb" aria-label="Núcleo de IA com quatro soluções em órbita; a selecionada mostra suas etapas"></canvas></div>
      <div>
        <div class="ai-list">
          <button type="button" aria-pressed="true"><span class="dot"></span><span class="n">Assistentes no WhatsApp</span></button>
          <button type="button" aria-pressed="false"><span class="dot"></span><span class="n">Agentes de voz em chamadas</span></button>
          <button type="button" aria-pressed="false"><span class="dot"></span><span class="n">IA para cálculos jurídicos</span></button>
