  function schedule() { clearTimeout(timer); if (!reduced) timer = setTimeout(() => select((active + 1) % 4), 8000); }
  btns.forEach((b, i) => b.addEventListener('click', () => select(i)));
  schedule();

  const geo = t => {
    const c = { x: S / 2, y: S / 2 };
    return CAPS.map((cap, i) => {
      const R = S * 0.25, a = cap.ang + Math.sin(t / 9000 + i) * 0.015;
      const p = { x: c.x + Math.cos(a) * R, y: c.y + Math.sin(a) * R };
      const n = cap.sats.length, spread = 1.5;
      const sats = cap.sats.map((label, j) => {
        const sa = a + (j - (n - 1) / 2) * (spread / Math.max(n - 1, 1)), sr = S * (0.1 + 0.06 * open[i]);
        return { label, x: p.x + Math.cos(sa) * sr, y: p.y + Math.sin(sa) * sr };
