      ctx.fillStyle = `rgba(34,255,110,${on * 0.15})`; ctx.beginPath(); ctx.arc(g.p.x, g.p.y, r + 10, 0, 7); ctx.fill();
      ctx.fillStyle = '#040806'; ctx.strokeStyle = on > 0.5 ? A : B; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.arc(g.p.x, g.p.y, r, 0, 7); ctx.fill(); ctx.stroke();
      ctx.font = `800 ${fs}px ${FONT}`; ctx.fillStyle = on > 0.5 ? A : DIM;
      const ly = g.p.y + (g.p.y < S / 2 ? -1 : 1) * (r + fs + 2);
      ctx.fillText(CAPS[i].name, g.p.x, ly);
