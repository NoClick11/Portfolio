  const btns = [...document.querySelectorAll('.ai-list button')], details = [...document.querySelectorAll('.ai-detail')];
  const CAPS = [
    { name: 'WhatsApp', ang: -2.36, sats: ['mensagem', 'histórico', 'sistema', 'resposta'] },
    { name: 'Voz', ang: -0.785, sats: ['ouvir', 'entender', 'falar'] },
    { name: 'Cálculos', ang: 0.785, sats: ['dados', 'calculadoras', 'resultado'] },
    { name: 'Agentes', ang: 2.36, sats: ['agente A', 'agente B', 'agente C', 'revisão'] }
